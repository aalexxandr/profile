{
  "permissions": {
    "allow": [
      "Bash(bun run lint*)",
      "Bash(bun run format*)",
      "Bash(bun run typecheck)",
      "Bash(bun run check)",
      "Bash(bun run fsd:check)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": ["Read(./.env*)", "Bash(rm -rf*)", "Bash(git push --force*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.ts\""
          }
        ]
      }
    ]
  }
}
